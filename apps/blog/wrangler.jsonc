{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "blog",
	"routes": [{ "pattern": "hayapo.dev/blog/*", "zone_name": "hayapo.dev" }],
	"main": "./dist/index.js",
	"compatibility_date": "2025-12-31",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist/public"
	}
}
